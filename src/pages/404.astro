---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — Shawn Lin" description="The page you were looking for is not here.">
  <SiteHeader />
  <main class="not-found shell">
    <p class="kicker">404 / Off the map</p>
    <h1>This moment<br />isn't here.</h1>
    <a class="text-link focus-ring" href="/">Return home <span aria-hidden="true">↗</span></a>
  </main>
  <SiteFooter />
</BaseLayout>
