---
import { getCollection } from 'astro:content';
import PageMasthead from '../../components/PageMasthead.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const photographs = (await getCollection('photography')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Photography — Shawn Lin"
  description="Places, light, and things Shawn wanted to remember."
>
  <div class="night-page">
    <SiteHeader />
    <main>
      <PageMasthead
        eyebrow="Photography / Selected frames"
        title="Places, light, and things I wanted to remember."
        intro="A growing visual notebook of familiar places, journeys farther away, and the small scenes that stayed with me."
        tone="night"
      />
      <section class="shell photography-index section-space" aria-label="Photography collections">
        {photographs.map((entry, index) => (
          <a class:list={['collection-card', `collection-${(index % 3) + 1}`, 'focus-ring']} href={`/photography/${entry.id}/`}>
            <div class="collection-image">
              <img
                src={entry.data.cover}
                alt={entry.data.coverAlt}
                width={entry.data.orientation === 'landscape' ? 1536 : 1120}
                height={entry.data.orientation === 'landscape' ? 1024 : 1400}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>
            <div class="collection-meta">
              <span>0{index + 1}</span>
              <h2>{entry.data.title}</h2>
              {entry.data.location && <small>{entry.data.location}</small>}
            </div>
          </a>
        ))}
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
