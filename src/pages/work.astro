---
import { getCollection } from 'astro:content';
import PageMasthead from '../components/PageMasthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featuredWork = work.filter((entry) => entry.data.featured);
const earlierWork = work.filter((entry) => !entry.data.featured);
---

<BaseLayout
  title="Work | Shawn Lin"
  description="Selected professional chapters from Shawn Lin's work across technical programs and software engineering."
>
  <SiteHeader />
  <main>
    <PageMasthead
      eyebrow="Work / Selected chapters"
      title="Turning technical complexity into shared momentum."
      intro="I work where engineering detail, cross-functional alignment, and practical execution meet. The role changes shape with the problem; the aim is always the same: make ambitious work easier to understand and move forward."
    />
    <section class="shell work-page-list section-space" aria-label="Professional experience">
      {featuredWork.map((entry, index) => (
        <article class="work-chapter">
          <div class="work-chapter-number">0{index + 1}</div>
          <header>
            <p>{entry.data.period}</p>
            <h2>{entry.data.company}</h2>
            <p>{entry.data.role}</p>
            {entry.data.location && <p class="work-chapter-location">{entry.data.location}</p>}
          </header>
          <p class="work-chapter-summary">{entry.data.summary}</p>
          <div class="work-chapter-note">
            <span>Selected impact</span>
            <ul class="work-highlights">
              {entry.data.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </section>
    <section class="shell earlier-work section-space" aria-labelledby="earlier-work-title">
      <header class="earlier-work-heading">
        <p class="kicker">Earlier chapters</p>
        <h2 id="earlier-work-title">The work before the title.</h2>
        <p>Software taught me how systems behave. Content taught me how people understand them. Both still shape how I lead programs today.</p>
      </header>
      <div class="earlier-work-list">
        {earlierWork.map((entry) => (
          <article class="earlier-work-row">
            <div>
              <p>{entry.data.period}</p>
              <h3>{entry.data.company}</h3>
            </div>
            <div>
              <p class="earlier-work-role">{entry.data.role}</p>
              <p>{entry.data.summary}</p>
            </div>
            <p>{entry.data.location}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="shell quiet-cta">
      <p>For the concise version</p>
      <a class="text-link focus-ring" href="/Shawn_Lin_Public_Resume.pdf">Download the public resume <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
