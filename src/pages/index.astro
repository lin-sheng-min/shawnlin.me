---
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteLinks } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const photographs = (await getCollection('photography'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const journal = (await getCollection('journal')).filter((entry) => !entry.data.draft);
const garden = (await getCollection('garden')).filter((entry) => !entry.data.draft);
const journalCategories = ['Travel', 'Food', 'Stay', 'Fly', 'Cards', 'Notes'];
---

<BaseLayout>
  <SiteHeader />
  <main class="home-page">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow-stack" aria-label="Professional context">
          <span>Technical Program Manager</span>
          <span>San Francisco, CA</span>
        </div>
        <h1 id="hero-title">
          Things I build,<br />
          places I go,<br />
          and moments<br />
          <em>I want to remember.</em>
        </h1>
        <a class="scroll-cue focus-ring" href="#selected-work">
          <span>Scroll to explore</span><span aria-hidden="true">↓</span>
        </a>
      </div>
      <figure class="hero-media">
        <img
          src="/images/home/golden-gate-from-lands-end.webp"
          alt="The Golden Gate Bridge beyond the rocky shoreline and cypress trees at Lands End"
          width="1867"
          height="2800"
          fetchpriority="high"
        />
        <figcaption>Golden Gate from Lands End · San Francisco</figcaption>
      </figure>
    </section>

    <section class="work-preview shell section-space" id="selected-work" aria-labelledby="work-heading">
      <div class="home-work-layout">
        <div class="home-work-label">
          <p class="kicker">01 / How I work</p>
          <span aria-hidden="true">✳</span>
        </div>
        <div class="home-work-content">
          <h2 id="work-heading">Turning scattered directions<br />into clear plans people<br /><em>can move with.</em></h2>
          <div class="home-work-principles">
            <article>
              <span>01</span>
              <h3>Find the signal</h3>
              <p>Make sense of incomplete information and competing priorities.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Create alignment</h3>
              <p>Give teams a shared direction and clear ownership.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Carry it through</h3>
              <p>Stay with the work through ambiguity, friction, and delivery.</p>
            </article>
          </div>
          <a class="text-link focus-ring" href="/work">Explore how I work <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="photography-home" aria-labelledby="photography-heading">
      <div class="shell section-space">
        <div class="section-intro photography-intro">
          <p class="kicker">02 / Photography</p>
          <div>
            <h2 id="photography-heading">Places, light,<br />and things I wanted<br /><em>to remember.</em></h2>
            <a class="text-link focus-ring" href="/photography">View photography <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="photo-collage">
          {photographs.map((entry, index) => (
            <a class:list={['photo-tile', `photo-${index + 1}`, 'focus-ring']} href={`/photography/${entry.id}/`}>
              <img
                src={entry.data.cover}
                alt={entry.data.coverAlt}
                width={entry.data.orientation === 'landscape' ? 1536 : 1120}
                height={entry.data.orientation === 'landscape' ? 1024 : 1400}
                loading="lazy"
              />
              <span class="photo-caption">
                <span>{entry.data.title}</span>
                {entry.data.location && <small>{entry.data.location}</small>}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="journal-home shell section-space" aria-labelledby="journal-heading">
      <div class="journal-head">
        <p class="kicker">03 / Journal</p>
        <h2 id="journal-heading">Notes from places I've been,<br />things I've tried, and rabbit holes<br /><em>I've fallen into.</em></h2>
      </div>
      <div class="category-line" aria-label="Journal categories">
        {journalCategories.map((category) => <span>{category}</span>)}
      </div>
      {journal.length === 0 ? (
        <div class="editorial-empty">
          <p>Nothing published for the sake of filling space.</p>
          <strong>Growing soon.</strong>
          <a class="text-link focus-ring" href="/journal">Enter the journal <span aria-hidden="true">↗</span></a>
        </div>
      ) : (
        <div class="journal-features">
          {journal.slice(0, 3).map((entry) => (
            <a class="journal-feature focus-ring" href={`/journal/${entry.id}/`}>
              {entry.data.cover && (
                <figure>
                  <img src={entry.data.cover} alt="" width={entry.data.coverWidth} height={entry.data.coverHeight} loading="lazy" />
                </figure>
              )}
              <div>
                <p class="kicker">{entry.data.category} / {entry.data.date.getFullYear()}</p>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <span>Read the note <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="garden-home" aria-labelledby="garden-heading">
      <div class="shell garden-grid section-space">
        <div>
          <p class="kicker">04 / Garden</p>
          <h2 id="garden-heading">Things I'm thinking about,<br />experimenting with,<br />or slowly bringing to life.</h2>
        </div>
        <div class="garden-note">
          <span class="garden-mark" aria-hidden="true">✳</span>
          {garden.length === 0 ? (
            <>
              <p>The garden is intentionally quiet for now. Ideas will appear here when they are ready to be tended in public.</p>
              <div class="status-key" aria-label="Garden statuses">
                {['Seed', 'Growing', 'Bloomed', 'Archived'].map((status) => <span>{status}</span>)}
              </div>
            </>
          ) : (
            <a href={`/garden/${garden[0].id}/`}>{garden[0].data.title}</a>
          )}
          <a class="text-link focus-ring" href="/garden">Visit the garden <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="about-home shell section-space" aria-labelledby="about-heading">
      <figure class="about-portrait">
        <img
          src="/images/about/shawn-and-dog.webp"
          alt="Shawn smiling beside his cream-colored dog"
          width="2800"
          height="1867"
          loading="lazy"
        />
      </figure>
      <div class="about-copy">
        <p class="kicker">05 / About</p>
        <h2 id="about-heading">I'm Shawn.</h2>
        <p>I work on technical programs, take too many photos, plan trips whenever I can, and rarely say no to boba. I am usually laughing at something, with Daisy, my mini Goldendoodle, not too far away.</p>
        <div class="inline-links" aria-label="About links">
          <a class="focus-ring" href={siteLinks.resume}>Resume</a>
          {siteLinks.linkedin ? <a class="focus-ring" href={siteLinks.linkedin}>LinkedIn</a> : <span title="Add Shawn's LinkedIn URL in src/data/site.ts">LinkedIn</span>}
          {siteLinks.email ? <a class="focus-ring" href={siteLinks.email}>Email</a> : <span title="Add Shawn's email link in src/data/site.ts">Email</span>}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
